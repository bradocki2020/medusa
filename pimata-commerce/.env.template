NODE_ENV=development
PORT=9000

# Banco PostgreSQL DEDICADO ao Medusa.
# Não use o mesmo banco PostgreSQL do Venda Única legado.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pimata_medusa

# Obrigatório em produção.
REDIS_URL=redis://localhost:6379

# URLs permitidas.
STORE_CORS=http://localhost:8000,https://venda.pimata.app
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000,https://venda.pimata.app

# Gere valores fortes e diferentes em produção. Nunca versionar os valores reais.
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-another-long-random-secret

# Local: shared. Produção: deploy separado com server e worker.
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
MEDUSA_BACKEND_URL=http://localhost:9000

# Migração gradual do Venda Única atual. Não versionar valores reais.
PIMATA_LEGACY_STOREFRONT=https://venda.pimata.app
PIMATA_LEGACY_SUPABASE_URL=https://your-project.supabase.co
PIMATA_LEGACY_SUPABASE_ANON_KEY=replace-with-publishable-key
