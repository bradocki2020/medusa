NODE_ENV=development
PORT=9000

# Banco PostgreSQL DEDICADO ao Medusa.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pimata_medusa
REDIS_URL=redis://localhost:6379

STORE_CORS=http://localhost:8000,https://venda.pimata.app
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000,https://venda.pimata.app

JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-another-long-random-secret

MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
MEDUSA_BACKEND_URL=http://localhost:9000

# Mercado Pago Checkout Pro — credenciais somente no servidor.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_BACKEND_URL=http://localhost:9000
MERCADO_PAGO_STOREFRONT_URL=https://venda.pimata.app
MERCADO_PAGO_STATEMENT_DESCRIPTOR=PIMATA

# Melhor Envio — token somente no servidor.
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=true
MELHOR_ENVIO_ORIGIN_POSTAL_CODE=
MELHOR_ENVIO_USER_AGENT=PiMaTa Commerce (contato@pimata.app)

# Migração gradual do Venda Única atual.
PIMATA_LEGACY_STOREFRONT=https://venda.pimata.app
PIMATA_LEGACY_SUPABASE_URL=https://your-project.supabase.co
PIMATA_LEGACY_SUPABASE_ANON_KEY=replace-with-publishable-key
